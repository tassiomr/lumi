# Copie para .env.local (desenvolvimento) e configure as mesmas variáveis na Vercel (Production).
# Nenhum valor abaixo é segredo: todos aparecem publicamente no site.
# NUNCA coloque AppKey/AppSecret da Tuya ou qualquer credencial aqui.

# Domínio oficial de produção, com https e sem barra final. Ex.: https://seu-dominio-oficial
NEXT_PUBLIC_SITE_URL=

# URL pública do Lumi na App Store. Deixe vazio até o app ser publicado.
NEXT_PUBLIC_APP_STORE_URL=

# E-mail de suporte (precisa existir e ser monitorado).
NEXT_PUBLIC_SUPPORT_EMAIL=

# E-mail para solicitações de privacidade/LGPD (pode ser o mesmo do suporte).
NEXT_PUBLIC_PRIVACY_EMAIL=

# Identificação do controlador de dados (razão social ou nome do titular responsável pela TR Media).
NEXT_PUBLIC_CONTROLLER_NAME=
# CNPJ ou outro registro, se houver. Opcional, mas recomendado.
NEXT_PUBLIC_CONTROLLER_DOCUMENT=
# Endereço para correspondência. Opcional.
NEXT_PUBLIC_CONTROLLER_ADDRESS=
# Nome do encarregado (DPO), se designado. Se vazio, o site informa o e-mail de privacidade como canal.
NEXT_PUBLIC_DPO_NAME=

# Cidade/UF do foro (Termos de Uso). Se vazio, vale o foro do domicílio do consumidor.
NEXT_PUBLIC_JURISDICTION_CITY=

# Marque "true" somente depois que a TR Media revisar os textos legais contra o app real.
# Enquanto não for "true", as páginas legais exibem um aviso de rascunho.
NEXT_PUBLIC_LEGAL_REVIEWED=false
